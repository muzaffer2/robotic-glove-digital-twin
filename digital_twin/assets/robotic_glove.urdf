<?xml version="1.0"?>
<robot name="textile_robotic_glove">

  <material name="textile_dark">
    <color rgba="0.16 0.20 0.28 1.0"/>
  </material>
  <material name="pneumatic_blue">
    <color rgba="0.18 0.58 0.95 1.0"/>
  </material>
  <material name="sensor_accent">
    <color rgba="0.95 0.55 0.15 1.0"/>
  </material>

  <link name="palm">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.088 0.022 0.100"/>
      </geometry>
      <material name="textile_dark"/>
    </visual>
    <visual>
      <origin xyz="0 -0.014 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.068 0.008 0.065"/>
      </geometry>
      <material name="pneumatic_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.088 0.022 0.100"/>
      </geometry>
    </collision>
  </link>

  <!-- Wrist cuff -->
  <link name="wrist_cuff">
    <inertial>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.076 0.026 0.050"/>
      </geometry>
      <material name="textile_dark"/>
    </visual>
  </link>
  <joint name="wrist_fixed" type="fixed">
    <parent link="palm"/>
    <child link="wrist_cuff"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= THUMB ================= -->
  <joint name="thumb_mcp" type="revolute">
    <parent link="palm"/>
    <child link="thumb_proximal"/>
    <origin xyz="-0.046 0.004 0.028" rpy="0 -0.55 0.55"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.35" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="thumb_proximal">
    <inertial><origin xyz="0 0 0.017"/><mass value="0.03"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.017"/><geometry><box size="0.018 0.016 0.034"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.010 0.017"/><geometry><box size="0.014 0.008 0.028"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="thumb_pip" type="revolute">
    <parent link="thumb_proximal"/>
    <child link="thumb_middle"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.55" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="thumb_middle">
    <inertial><origin xyz="0 0 0.014"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.016 0.015 0.028"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.009 0.014"/><geometry><box size="0.012 0.007 0.022"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="thumb_dip" type="revolute">
    <parent link="thumb_middle"/>
    <child link="thumb_distal"/>
    <origin xyz="0 0 0.029" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.20" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="thumb_distal">
    <inertial><origin xyz="0 0 0.011"/><mass value="0.015"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.011"/><geometry><box size="0.015 0.014 0.022"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.008 0.011"/><geometry><box size="0.011 0.006 0.018"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <!-- ================= INDEX FINGER (Channel 1 Active) ================= -->
  <joint name="index_mcp" type="revolute">
    <parent link="palm"/>
    <child link="index_proximal"/>
    <origin xyz="-0.031 0 0.102" rpy="0 -0.05 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.55" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="index_proximal">
    <inertial><origin xyz="0 0 0.021"/><mass value="0.03"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.021"/><geometry><box size="0.016 0.015 0.042"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.010 0.021"/><geometry><box size="0.013 0.008 0.036"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="index_pip" type="revolute">
    <parent link="index_proximal"/>
    <child link="index_middle"/>
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.75" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="index_middle">
    <inertial><origin xyz="0 0 0.014"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.015 0.014 0.028"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.009 0.014"/><geometry><box size="0.012 0.007 0.024"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="index_dip" type="revolute">
    <parent link="index_middle"/>
    <child link="index_distal"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.30" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="index_distal">
    <inertial><origin xyz="0 0 0.011"/><mass value="0.015"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.011"/><geometry><box size="0.014 0.013 0.022"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.008 0.011"/><geometry><box size="0.010 0.006 0.018"/></geometry><material name="sensor_accent"/></visual>
  </link>

  <!-- ================= MIDDLE FINGER ================= -->
  <joint name="middle_mcp" type="revolute">
    <parent link="palm"/>
    <child link="middle_proximal"/>
    <origin xyz="-0.010 0 0.104" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.55" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="middle_proximal">
    <inertial><origin xyz="0 0 0.023"/><mass value="0.03"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.023"/><geometry><box size="0.016 0.015 0.046"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.010 0.023"/><geometry><box size="0.013 0.008 0.040"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="middle_pip" type="revolute">
    <parent link="middle_proximal"/>
    <child link="middle_middle"/>
    <origin xyz="0 0 0.048" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.75" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="middle_middle">
    <inertial><origin xyz="0 0 0.015"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.015"/><geometry><box size="0.015 0.014 0.030"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.009 0.015"/><geometry><box size="0.012 0.007 0.025"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="middle_dip" type="revolute">
    <parent link="middle_middle"/>
    <child link="middle_distal"/>
    <origin xyz="0 0 0.032" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.30" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="middle_distal">
    <inertial><origin xyz="0 0 0.012"/><mass value="0.015"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.012"/><geometry><box size="0.014 0.013 0.024"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.008 0.012"/><geometry><box size="0.010 0.006 0.019"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <!-- ================= RING FINGER ================= -->
  <joint name="ring_mcp" type="revolute">
    <parent link="palm"/>
    <child link="ring_proximal"/>
    <origin xyz="0.011 0 0.102" rpy="0 0.04 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.55" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="ring_proximal">
    <inertial><origin xyz="0 0 0.021"/><mass value="0.03"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.021"/><geometry><box size="0.015 0.015 0.042"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.010 0.021"/><geometry><box size="0.012 0.008 0.036"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="ring_pip" type="revolute">
    <parent link="ring_proximal"/>
    <child link="ring_middle"/>
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.75" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="ring_middle">
    <inertial><origin xyz="0 0 0.014"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.014 0.014 0.028"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.009 0.014"/><geometry><box size="0.011 0.007 0.024"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="ring_dip" type="revolute">
    <parent link="ring_middle"/>
    <child link="ring_distal"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.30" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="ring_distal">
    <inertial><origin xyz="0 0 0.011"/><mass value="0.015"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.011"/><geometry><box size="0.013 0.013 0.022"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.008 0.011"/><geometry><box size="0.010 0.006 0.018"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <!-- ================= LITTLE FINGER ================= -->
  <joint name="little_mcp" type="revolute">
    <parent link="palm"/>
    <child link="little_proximal"/>
    <origin xyz="0.032 0 0.097" rpy="0 0.09 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.55" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="little_proximal">
    <inertial><origin xyz="0 0 0.017"/><mass value="0.025"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.017"/><geometry><box size="0.014 0.014 0.034"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.009 0.017"/><geometry><box size="0.011 0.007 0.028"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="little_pip" type="revolute">
    <parent link="little_proximal"/>
    <child link="little_middle"/>
    <origin xyz="0 0 0.036" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.75" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="little_middle">
    <inertial><origin xyz="0 0 0.012"/><mass value="0.018"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.012"/><geometry><box size="0.013 0.013 0.024"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.008 0.012"/><geometry><box size="0.010 0.006 0.020"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

  <joint name="little_dip" type="revolute">
    <parent link="little_middle"/>
    <child link="little_distal"/>
    <origin xyz="0 0 0.026" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.30" effort="5.0" velocity="6.0"/>
  </joint>
  <link name="little_distal">
    <inertial><origin xyz="0 0 0.010"/><mass value="0.012"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0.010"/><geometry><box size="0.012 0.012 0.020"/></geometry><material name="textile_dark"/></visual>
    <visual><origin xyz="0 -0.007 0.010"/><geometry><box size="0.009 0.005 0.016"/></geometry><material name="pneumatic_blue"/></visual>
  </link>

</robot>
